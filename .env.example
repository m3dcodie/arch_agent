# AWS Configuration
AWS_PROFILE=default
AWS_REGION=us-east-1

# LLM Configuration
LLM_PROVIDER=bedrock
# Use ANTHROPIC_MODEL for inference profile ARN (preferred for cross-region inference)
# Format: <region>.anthropic.<model-name>
# Example for ap-southeast-2: au.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_MODEL=au.anthropic.claude-sonnet-4-5-20250929-v1:0
# Fallback to LLM_MODEL_ID for base model ID
LLM_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# Database Configuration (LangGraph Checkpoints)
DB_PROVIDER=sqlite
DB_PATH=./data/adag.db

# Phase 2: RAG Configuration
RAG_PROVIDER=chroma
CHROMA_PERSIST_DIR=./data/chroma
POLICIES_DIR=./policies
USE_RAG=true

# HuggingFace (free testing — set LLM_PROVIDER=huggingface to activate)
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_TEMPERATURE=0.1
HF_MAX_TOKENS=2048

# Ollama (local model testing — set LLM_PROVIDER=ollama to activate)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# GitHub Copilot (set LLM_PROVIDER=github-copilot to activate)
# Requires an active GitHub Copilot subscription (Individual, Business, or Enterprise).
# Get an OAuth token with: gh auth login --scopes 'copilot' && gh auth token
# Some models (claude-*, gemini-*) require a Copilot Pro+ or Enterprise plan.
GITHUB_COPILOT_TOKEN=ghu_your_oauth_token_here
GITHUB_COPILOT_MODEL=gpt-4o
# Optional:
# GITHUB_COPILOT_TEMPERATURE=0.1
# GITHUB_COPILOT_MAX_TOKENS=4096

# Per-agent model selection (HuggingFace and Ollama providers only)
# Overrides the provider default for a specific agent role.
# Leave unset to use the same model for all agents.
#
# Intake agent — L1 Scout (Processor): fast, high-compliance, structured JSON.
#   Recommended HF free models:
#     Qwen/Qwen2.5-7B-Instruct        (default HF_MODEL — fast & accurate JSON)
#     meta-llama/Llama-3.2-3B-Instruct (even faster, lower cost)
#INTAKE_MODEL=Qwen/Qwen2.5-7B-Instruct
#
# Auditor agent — L3 Strategist (Architect): reasoning, judgment, policy analysis.
#   Recommended HF free models:
#     Qwen/Qwen2.5-72B-Instruct           (strong reasoning, free on HF router)
#     meta-llama/Llama-3.3-70B-Instruct   (frontier-class, free on HF router)
#     deepseek-ai/DeepSeek-R1-Distill-Qwen-32B  (reasoning model, free on HF)
#AUDITOR_MODEL=Qwen/Qwen2.5-72B-Instruct

# Application Settings
LOG_LEVEL=INFO
