# AWS Configuration
AWS_PROFILE=default
AWS_REGION=us-east-1
# LLM Configuration
LLM_PROVIDER=bedrock
# Single temperature for all providers (default: 0 = greedy/deterministic, recommended for compliance auditing).
# Override per-provider with BEDROCK_TEMPERATURE, OLLAMA_TEMPERATURE, HF_TEMPERATURE, etc.
LLM_TEMPERATURE=0
# Max output tokens for all providers (default: 4096). Override per-provider with BEDROCK_MAX_TOKENS, HF_MAX_TOKENS, etc.
LLM_MAX_TOKENS=4096
# Use ANTHROPIC_MODEL for inference profile ARN (preferred for cross-region inference)
# Format: <region>.anthropic.<model-name>
# Example for ap-southeast-2: au.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_MODEL=au.anthropic.claude-sonnet-4-5-20250929-v1:0
# Fallback to LLM_MODEL_ID for base model ID
LLM_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# Database Configuration (LangGraph Checkpoints)
DB_PROVIDER=sqlite
DB_PATH=./data/adag.db

# RAG Mode (Mode 3 — Advanced RAG via external microservices)
# Set USE_RAG=true only when the RAG microservices are running.
# See docs/RAG_PIPELINE.md for setup instructions.
USE_RAG=false
ADAG_APPID=archapp
POLICIES_DIR=./policies

# RAG microservice URLs (only needed when USE_RAG=true)
# RAG_CONTEXT_URL=http://localhost:8000
# RAG_INGEST_URL=http://localhost:8001
# RAG_CHUNK_URL=http://localhost:8002
# RAG_EMBED_URL=http://localhost:8003
# RAG_VECTOR_URL=http://localhost:8004

# If you want to use a custom policies directory (recommended for org-wide rules),
# set POLICIES_DIR to the folder containing your policy .md files. If unset,
# ADAG will use the built-in policies/ bundle that ships with the package.
# Example:
# POLICIES_DIR=./my-org-policies

# HuggingFace (free testing — set LLM_PROVIDER=huggingface to activate)
# Get a free token at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1

# Ollama (local model testing — set LLM_PROVIDER=ollama to activate)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# GitHub Copilot (set LLM_PROVIDER=github-copilot to activate)
# Requires an active GitHub Copilot subscription (Individual, Business, or Enterprise).
# Step 1: gh auth login --scopes 'copilot'
# Step 2: gh auth status --show-token   → copy the gho_… token
# In GitHub Actions: store as secret GH_COPILOT_TOKEN, then map it:
#   env:
#     GITHUB_COPILOT_TOKEN: ${{ secrets.GH_COPILOT_TOKEN }}
# (GITHUB_* names are reserved for built-in secrets; use GH_* for custom ones)
GITHUB_COPILOT_TOKEN=gho_your_oauth_token_here
GITHUB_COPILOT_MODEL=claude-sonnet-4.5
# Available models (no openai/ prefix — Copilot format):
#   claude-sonnet-4.5   claude-sonnet-4   claude-haiku-4.5   claude-opus-4.5
#   gpt-4.1             gpt-4.1-2025-04-14
#   gpt-4o-mini         gpt-4o-mini-2024-07-18

# GitHub Models (set LLM_PROVIDER=github-models to activate)
# Create a PAT at https://github.com/settings/personal-access-tokens/new
#   → Account permissions: GitHub Copilot (Read) + Models (Read)
GITHUB_MODELS_TOKEN=github_pat_your_token_here
GITHUB_MODELS_MODEL=openai/gpt-4.1
# Available models (require openai/ prefix — Models format):
#   openai/gpt-4.1      openai/gpt-4.1-2025-04-14
#   openai/gpt-4o-mini  openai/gpt-4o-mini-2024-07-18

# Per-agent model selection (works with ALL providers)
# AUDITOR_MODEL is the key variable — controls which model does the compliance
# reasoning. If unset, the provider default model is used for all agents.
#
# GitHub Copilot examples (no openai/ prefix):
#INTAKE_MODEL=gpt-4o-mini
#AUDITOR_MODEL=claude-haiku-4.5
#
# GitHub Models examples (requires openai/ prefix):
#INTAKE_MODEL=openai/gpt-4o-mini
#AUDITOR_MODEL=openai/gpt-4.1
#
# HuggingFace examples:
#INTAKE_MODEL=Qwen/Qwen2.5-7B-Instruct
#AUDITOR_MODEL=Qwen/Qwen2.5-72B-Instruct
#
# Ollama examples:
#INTAKE_MODEL=qwen2.5:7b
#AUDITOR_MODEL=deepseek-r1:32b

# Application Settings
LOG_LEVEL=INFO

# Copy this file to .env and edit values for your environment:
# cp .env.example .env
